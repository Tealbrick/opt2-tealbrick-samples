{
  "$schema": "https://raw.githubusercontent.com/Tealbrick/opt2-tealbrick-platform/ci-v9.20/ci/tealbrick-ci.schema.json",
  "kind": "miniapp",
  "paths": ["sample-gate", "sample-caller", "sample-pay", "sample-mismatch"],
  "images": [
    {
      "name": "opt2-tealbrick-samples-gate",
      "product": "sample-gate",
      "kind": "app",
      "context": "sample-gate",
      "dockerfile": "sample-gate/Dockerfile",
      "manifest": "sample-gate/tealbrick.manifest.json"
    },
    {
      "name": "opt2-tealbrick-samples-caller",
      "product": "sample-caller",
      "kind": "app",
      "context": "sample-caller",
      "dockerfile": "sample-caller/Dockerfile",
      "manifest": "sample-caller/tealbrick.manifest.json"
    },
    {
      "name": "opt2-tealbrick-samples-pay",
      "product": "sample-pay",
      "kind": "app",
      "context": "sample-pay",
      "dockerfile": "sample-pay/Dockerfile",
      "manifest": "sample-pay/tealbrick.manifest.json"
    },
    {
      "name": "opt2-tealbrick-samples-mismatch",
      "product": "sample-mismatch",
      "kind": "app",
      "context": "sample-mismatch",
      "dockerfile": "sample-mismatch/Dockerfile",
      "manifest": "sample-mismatch/tealbrick.manifest.json"
    }
  ]
}
